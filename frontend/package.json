{
  "name": "igallery",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@fontsource/roboto": "^4.5.8",
    "@hono/node-server": "^2.1.5",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "hono": "^4.13.16",
    "jsdoc": "^4.0.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-scripts": "5.0.1",
    "three": "~0.186.1",
    "web-vitals": "^2.1.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:start\"",
    "dev:api": "tsx watch --env-file-if-exists=.env.local scripts/dev-api.ts",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "optimize:artworks": "node scripts/optimize-artworks.mjs",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "typecheck": "tsc -p api"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "concurrently": "^10.0.6",
    "eslint": "^8.35.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-react": "^7.32.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "proxy": "http://localhost:3001",
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
