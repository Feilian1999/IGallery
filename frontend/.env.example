# Copy to .env.local for local development (all optional locally).
# On Vercel, set these under Project → Settings → Environment Variables.

# Neon Postgres connection string. Locally, leave empty to use the embedded PGlite database.
DATABASE_URL=

# Vercel Blob read/write token. Locally, leave empty to store uploads in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# First admin account, created when the users table is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
