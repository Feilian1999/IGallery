# Copy to .env.local for local development (all optional locally).
# On Vercel, set these under Project → Settings → Environment Variables.

# Neon Postgres connection string (POSTGRES_URL also works).
# Locally, leave empty to use the embedded PGlite database.
DATABASE_URL=

# Vercel Blob. Connecting a store to the project adds these automatically: newer stores
# use BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (with Vercel's OIDC token), older ones
# BLOB_READ_WRITE_TOKEN. Locally, leave all empty to store uploads in .data/uploads.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# First admin account, created when the users table is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
